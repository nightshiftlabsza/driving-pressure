    "evidence": [
      {
        "claim": "In severe asthma on mechanical ventilation, set respiratory rate should be reduced (10-14 bpm) with high inspiratory flow (70-80 L/min) to prolong expiratory time and minimize auto-PEEP and dynamic hyperinflation.",
        "source": "Leatherman J. Mechanical ventilation for severe asthma. Chest 2015;147(6):1671-1680",
        "year": 2015,
        "kind": "review"
      },
      {
        "claim": "Ventilator disconnection (apnoea trial) is the immediate diagnostic and therapeutic intervention for suspected auto-PEEP-induced hypotension or pulseless electrical activity in obstructive lung disease.",
        "source": "Tuxen DV. Detrimental effects of positive end-expiratory pressure during controlled mechanical ventilation of patients with severe airflow obstruction. Am Rev Respir Dis 1989;140(1):5-9",
        "year": 1989,
        "kind": "trial"
      },
      {
        "claim": "Plateau pressure should be maintained <= 30 cmH2O and auto-PEEP <= 5-10 cmH2O to prevent pulmonary barotrauma and hemodynamic compromise in mechanically ventilated asthma.",
        "source": "Oddo M, et al. Management of mechanical ventilation in acute severe asthma. Intensive Care Med 2006;32:501-510",
        "year": 2006,
        "kind": "review"
      }
    ],
    "patient": {
      "displayName": "Elena Rostova (synthetic)",
      "presentingStory": "Transferred from the emergency department 20 minutes after rapid sequence intubation for acute severe bronchospasm unresponsive to initial continuous nebulisers. The transport ventilator was switched to the ICU ventilator. The bedside nurse calls urgently because the high peak pressure alarm is active and blood pressure is falling.",
      "history": "Severe persistent asthma since childhood with two prior ICU admissions. No regular inhaled corticosteroids for past 3 months. Presented to ED in extremis with silent chest and exhaustion.",
