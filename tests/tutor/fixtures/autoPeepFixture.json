    "predictionPoints": [
      {
        "id": "p-asthma-mechanics",
        "competency": "modes.ie-flow-ti",
        "evidenceType": "prediction",
        "question": "You are implementing an obstructive lung strategy (reducing RR to 10-12 bpm and increasing peak inspiratory flow to 70-80 L/min). Over the next 15-30 minutes, which direction will each parameter move?",
        "format": "direction",
        "variables": [
          "autoPeep",
          "ppeak",
          "sbp",
          "paco2"
        ],
        "marking": "engine",
        "explanation": "Lengthening expiratory time allows trapped air to escape, reducing auto-PEEP and peak airway pressure. Lower intrathoracic pressure restores venous return and increases SBP. PaCO2 will initially rise due to reduced minute ventilation (permissive hypercapnia), which is well tolerated and protective.",
        "hidden": false
      },
      {
        "id": "p-asthma-disconnect",
        "competency": "circ.auto-peep-hypotension",
        "evidenceType": "decision",
        "question": "If a mechanically ventilated patient with life-threatening bronchospasm abruptly develops severe hypotension and tachycardia, what is the most immediate life-saving action?",
        "format": "choice",
        "options": [
          "Disconnect the patient from the ventilator to allow complete exhalation of trapped air",
          "Increase the set respiratory rate to clear accumulating carbon dioxide",
          "Increase external PEEP to 15 cmH2O to stent open small airways",
          "Infuse 100 mL of 8.4% sodium bicarbonate immediately"
        ],
        "marking": "fixed",
        "answerKey": "Disconnect the patient from the ventilator to allow complete exhalation of trapped air",
        "explanation": "Ventilator disconnection (the 'apnoea trial') immediately vents trapped intra-thoracic air. If hypotension was caused by auto-PEEP and reduced venous return, hemodynamics will dramatically improve within 10-20 seconds.",
        "hidden": true
      }
    ],
