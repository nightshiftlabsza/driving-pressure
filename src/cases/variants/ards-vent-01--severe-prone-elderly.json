    "predictionPoints": [
      {
        "id": "p-pbw",
        "competency": "disease.ards",
        "evidenceType": "interpretation",
        "question": "Before touching the ventilator: what is his predicted body weight? (male, 178 cm)",
        "format": "numeric",
        "unit": "kg",
        "marking": "fixed",
        "answerKey": 73,
        "tolerance": 2,
        "explanation": "PBW (male) = 50 + 0.91 × (height in cm − 152.4) = 50 + 0.91 × 25.6 ≈ 73 kg. His 600 mL initial tidal volume is about 8.2 mL/kg PBW. Target 6 mL/kg is about 440 mL.",
        "hidden": false
      },
      {
        "id": "p-settings-effect",
        "competency": "mech.eom",
        "evidenceType": "prediction",
        "question": "You have just changed the ventilator. Once things settle, which way will each of these go?",
        "format": "direction",
        "variables": [
          "pplat",
          "paco2",
          "spo2"
        ],
        "marking": "engine",
        "explanation": "Plateau pressure = PEEP + VT/compliance. Titrating PEEP and adjusting VT alters airway pressures and alveolar ventilation.",
        "hidden": false
      },
      {
        "id": "p-severe-next",
        "competency": "disease.ards",
        "evidenceType": "decision",
        "question": "Twenty minutes on protective settings. What is the next step for his oxygenation?",
