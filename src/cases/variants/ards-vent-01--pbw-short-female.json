{
  "variantId": "ards-vent-01--pbw-short-female",
  "baseCaseId": "ards-vent-01",
  "title": "Severe hypoxaemia transferred on fixed ED ventilator settings",
  "summary": "A 58-year-old woman with severe bilateral pneumonia arrives from the emergency department on 650 mL tidal volumes.",
  "rationale": "Short obese female with ARDS to test the predicted-body-weight (PBW) trap. Clinicians calculating Vt from actual weight (94 kg) perceive 650 mL as ~6.9 mL/kg, but based on her 152 cm height, PBW is only 45 kg (making 650 mL a dangerous 14.4 mL/kg). Re-tests knowledge gap and unsafe ventilation.",
  "retestsMistake": {
    "mistakeId": "knowledge_gap",
    "competencyId": "disease.ards",
    "clinicalFocus": "Predicted body weight calculation and tidal volume restriction in short stature with obesity"
  },
  "source": "ARDS Network. N Engl J Med 2000;342:1301-8; The Ventilator Book (Owens 2021); teaching-convention",
  "changes": {
    "vignette": "Female 58, height 152 cm, weight 94 kg (down from male 61, 170 cm, 98 kg). Transferred on 650 mL ED settings.",
    "parametersChanged": {
      "sex": {
        "from": "M",
        "to": "F",
        "reason": "Tests female PBW formula (45.5 baseline vs 50 for male)"
      },
      "heightCm": {
        "from": 170,
        "to": 152,
        "reason": "Height near minimum baseline to accentuate discrepancy between actual and predicted weight"
      },
      "actualWeightKg": {
        "from": 98,
        "to": 94,
        "reason": "Severe obesity maintaining high actual weight"
      },
      "complianceMlPerCmH2O": {
        "from": 24,
        "to": 20,
        "reason": "Severely stiff ARDS lungs in smaller chest cage"
      },
      "anatomicDeadSpaceMl": {
        "from": 150,
        "to": 105,
        "reason": "Scaled to smaller stature/PBW"
      },
      "vco2MlPerMin": {
        "from": 260,
        "to": 220,
        "reason": "Scaled to female body composition"
      },
      "vo2MlPerMin": {
        "from": 300,
        "to": 260,
        "reason": "Scaled to female metabolic rate"
      }
    }
  },
  "overlay": {
    "patient": {
      "displayName": "Mrs E. Davies (synthetic)",
      "presentingStory": "Intubated in the ED 45 minutes ago for worsening hypoxaemia with community-acquired pneumonia. Sedated and paralysed. The ED medical officer set the ventilator to 650 mL because \"she weighs nearly 100 kilos\". She has just been transferred into your ICU bed on the same ventilator settings.",
      "history": "Hypertension, class III obesity, type 2 diabetes. One week of fever and productive cough. Bilateral diffuse airspace opacities on chest radiograph. Height 152 cm, weight 94 kg. Full code.",
      "params": {
        "sex": "F",
        "ageYears": 58,
        "heightCm": 152,
        "actualWeightKg": 94,
        "complianceMlPerCmH2O": 20,
        "inspResistanceCmH2OPerLps": 12,
        "expResistanceCmH2OPerLps": 12,
        "spontRateBpm": 0,
        "pmusAmplitudeCmH2O": 0,
        "pmusInspTimeSec": 0.9,
        "vco2MlPerMin": 220,
        "vo2MlPerMin": 260,
        "anatomicDeadSpaceMl": 105,
        "alveolarDeadSpaceFraction": 0.36,
        "shuntFraction": 0.38,
        "recruitability": 0.5,
        "hbGPerDl": 11.5,
        "temperatureC": 38.2,
        "baselineHco3MmolL": 21,
        "hrBaselineBpm": 106,
        "sbpBaselineMmHg": 110,
        "dbpBaselineMmHg": 62,
        "ppvResponse": "unhelpful",
        "ppvSeverity": 0.4,
        "respiratoryReserve": 0.6
      }
    },
    "predictionPoints": [
      {
        "id": "p-pbw",
        "competency": "disease.ards",
        "evidenceType": "interpretation",
        "question": "Before touching the ventilator: what is her predicted body weight? (female, 152 cm)",
        "format": "numeric",
        "unit": "kg",
        "marking": "fixed",
        "answerKey": 45,
        "tolerance": 2,
        "explanation": "PBW (female) = 45.5 + 0.91 × (height in cm − 152.4) ≈ 45 kg. So 6 mL/kg is about 270 mL. The 650 mL she arrived on is over 14 mL/kg PBW, causing extreme volutrauma and high plateau pressures despite appearing moderate for 94 kg actual weight.",
        "hidden": false
      },
      {
        "id": "p-settings-effect",
        "competency": "mech.eom",
        "evidenceType": "prediction",
        "question": "You have just changed the ventilator. Once things settle, which way will each of these go?",
        "format": "direction",
        "variables": [
          "pplat",
          "paco2",
          "spo2"
        ],
        "marking": "engine",
        "explanation": "Plateau pressure = PEEP + VT/compliance. Lowering VT lowers it; raising PEEP raises it by about the same amount at a fixed VT. Lower VT cuts alveolar ventilation unless the rate rises enough, so PaCO2 tends to rise. The engine marks this against actual physiology.",
        "hidden": false
      },
      {
        "id": "p-severe-next",
        "competency": "disease.ards",
        "evidenceType": "decision",
        "question": "Twenty minutes on protective settings. What is the next step for her oxygenation?",
        "format": "choice",
        "options": [
          "Prone positioning for 16 hours or more a day",
          "Inhaled nitric oxide",
          "High-frequency oscillatory ventilation",
          "Staircase recruitment manoeuvres"
        ],
        "marking": "fixed",
        "answerKey": "Prone positioning for 16 hours or more a day",
        "explanation": "PROSEVA showed lower mortality with early prolonged proning when P/F was below 150.",
        "hidden": false
      }
    ],
    "rubric": [
      {"id": "r-fio2-weaned", "description": "Weaned FiO2 once SpO2 was above 95%", "competency": "modes.peep-fio2", "evidenceType": "decision", "met": {"not": {"all": [{"threshold": {"metric": "spo2", "op": ">", "value": 95}}, {"threshold": {"metric": "fio2", "op": ">", "value": 0.5}}]}}, "weight": 1, "critical": false},
