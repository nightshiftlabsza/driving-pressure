      {
        "id": "p-settings-effect",
        "competency": "mech.eom",
        "evidenceType": "prediction",
        "question": "You have just changed the ventilator. Once things settle, which way will each of these go?",
        "format": "direction",
        "variables": [
          "pplat",
          "paco2",
          "spo2"
        ],
        "marking": "engine",
        "explanation": "Plateau pressure = PEEP + VT/compliance. Lowering VT lowers it. In a recruitable lung, raising PEEP recruits collapsed alveoli, increasing compliance and lowering driving pressure, but excessive PEEP can cause overdistension. A lower VT cuts alveolar ventilation unless the rate rises enough, so PaCO2 tends to rise. More PEEP usually improves oxygenation in recruitable lung. The engine marks this against what actually happened with your settings.",
        "hidden": false
      },
      {
        "id": "p-severe-next",
        "competency": "disease.ards",
        "evidenceType": "decision",
        "question": "Twenty minutes on protective settings. What is the next step for his oxygenation?",
        "format": "choice",
        "options": [
          "Prone positioning for 16 hours or more a day",
          "Inhaled nitric oxide",
          "High-frequency oscillatory ventilation",
          "Staircase recruitment manoeuvres"
        ],
        "marking": "fixed",
        "answerKey": "Prone positioning for 16 hours or more a day",
        "explanation": "PROSEVA showed lower mortality with early prolonged proning when P/F was below 150. Inhaled nitric oxide improves oxygenation without a survival benefit, and high-frequency oscillation (OSCILLATE) and staircase recruitment manoeuvres (ART) were associated with harm.",
        "hidden": false
      }
