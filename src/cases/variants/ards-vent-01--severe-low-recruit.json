        "id": "p-pbw",
        "competency": "disease.ards",
        "evidenceType": "interpretation",
        "question": "Before touching the ventilator: what is his predicted body weight? (male, 172 cm)",
        "format": "numeric",
        "unit": "kg",
        "marking": "fixed",
        "answerKey": 68,
        "tolerance": 2,
        "explanation": "PBW (male) = 50 + 0.91 x (height in cm - 152.4) = about 68 kg. Tidal volume is set from PBW, not actual weight; 6 mL/kg is about 408 mL.",
        "hidden": false
